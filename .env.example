# Бот от @BotFather
BOT_TOKEN=123456:ABC...

# Приложение с https://my.telegram.org
API_ID=123456
API_HASH=abcdef...

# Аккаунт, который будет сидеть в чатах и читать подарки (юзербот)
PHONE=+79001234567

# Ваш Telegram ID (можно несколько через запятую). Узнать: @userinfobot
ADMIN_IDS=123456789

# Опционально: токен Portals. В web.telegram.org откройте @portals,
# Network → любой запрос на portal-market.com → заголовок Authorization (tma ...)
PORTALS_AUTH=

# Опционально: web-initData с market.tonnel.network (Local Storage)
TONNEL_AUTH=

# Если MTProto режется: локальный SOCKS VPN (v2rayN / Hiddify часто 10808)
# На Bothost PROXY_* не ставь — 127.0.0.1 там не работает.
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=10808

# Bothost: вставь String Session в переменные окружения панели (не в Git).
# SESSION_STRING=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
